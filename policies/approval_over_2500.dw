// ApprovalOver2500: a transfer over 2,500 dollars needs a matching supervisor approval, recorded in this
// policy session by record_transfer_approval, for the same member, destination and amount.
forbid (principal, action == AgentCore::Action::"MemberRecords___initiate_transfer", resource is AgentCore::Gateway)
when { context.input.amount > 2500 }
unless temporal { formerly within 1h AgentCore::Action::"MemberRecords___record_transfer_approval"::response{ eventResource: resource,
    input.member_id: context.input.member_id, input.destination_ref: context.input.destination_ref,
    input.amount: context.input.amount, output.approved: true } };
